<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Products.ViewModels"
             xmlns:models="clr-namespace:Products.Models"
             x:Class="Products.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#0F172A"
             Title="Enterprise Sales Portal">

    <!-- Main Grid: Left POS / Master Panel (380px), Right Dashboard Panel (*) -->
    <Grid ColumnDefinitions="380,*" 
          ColumnSpacing="16" 
          Padding="16">

        <!-- ================= LEFT PANE: WORKFLOW ================= -->
        <ScrollView Grid.Column="0">
            <VerticalStackLayout Spacing="14">

                <!-- PANEL 1: POINT OF SALE (CHECKOUT) -->
                <Border Stroke="#1E293B"
                        StrokeThickness="1"
                        BackgroundColor="#1E293B"
                        Padding="16"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Point of Sale" 
                               TextColor="#F8FAFC"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <!-- Customer Picker -->
                        <Label Text="Customer" TextColor="#94A3B8" FontSize="12" />
                        <Picker ItemsSource="{Binding CustomersList}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedCustomer}"
                                Title="Select Customer"
                                TextColor="#FFFFFF"
                                TitleColor="#64748B"
                                BackgroundColor="#0F172A" />

                        <!-- Product Picker & Qty -->
                        <Label Text="Item &amp; Quantity" TextColor="#94A3B8" FontSize="12" />
                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
                            <Picker Grid.Column="0"
                                    ItemsSource="{Binding ProductsList}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedProduct}"
                                    Title="Select Product"
                                    TextColor="#FFFFFF"
                                    TitleColor="#64748B"
                                    BackgroundColor="#0F172A" />
                            <Entry Grid.Column="1"
                                   Text="{Binding ItemQuantityText}"
                                   Placeholder="Qty"
                                   Keyboard="Numeric"
                                   TextColor="#FFFFFF" 
                                   BackgroundColor="#0F172A" 
                                   HorizontalTextAlignment="Center" />
                        </Grid>

                        <Button Text="+ Add Line Item" Command="{Binding AddToCartCommand}"
                                BackgroundColor="#334155" 
                                TextColor="#F8FAFC" 
                                HeightRequest="38" 
                                CornerRadius="6" />

                        <!-- Mini Cart -->
                        <Label Text="Order Summary" 
                               TextColor="#94A3B8" 
                               FontSize="12" 
                               Margin="0,4,0,0"/>
                        <Border Stroke="#334155"
                                BackgroundColor="#0F172A"
                                HeightRequest="120" 
                                StrokeShape="RoundRectangle 6"
                                Padding="6">
                            <CollectionView ItemsSource="{Binding CartItems}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CartItem">
                                        <Grid ColumnDefinitions="2*,*,*,Auto" Padding="4" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="{Binding ProductName}" TextColor="#E2E8F0" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" TextColor="#94A3B8" />
                                            <Label Grid.Column="2" Text="{Binding LineTotal, StringFormat='{0:C}'}" TextColor="#38BDF8" />
                                            <Button Grid.Column="3" Text="✕" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=RemoveFromCartCommand}"
                                                    CommandParameter="{Binding .}" TextColor="#EF4444" BackgroundColor="Transparent" Padding="0" WidthRequest="24" HeightRequest="24" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>

                        <!-- Cart Total & Submit -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Label Text="{Binding CartTotal, StringFormat='Total: {0:C}'}" FontSize="16" FontAttributes="Bold" TextColor="#4ADE80" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Process Order" Command="{Binding CheckoutOrderCommand}"
                                    BackgroundColor="#16A34A" TextColor="#FFFFFF" FontAttributes="Bold" HeightRequest="40" CornerRadius="6" Padding="14,0" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- PANEL 2: MASTER RECORD REGISTRATION -->
                <Border Stroke="#1E293B" StrokeThickness="1" BackgroundColor="#1E293B" Padding="16" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Master Data Intake" TextColor="#F8FAFC" FontSize="14" FontAttributes="Bold" />

                        <!-- Product Form -->
                        <Label Text="Register Product" TextColor="#94A3B8" FontSize="11" />
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                            <Entry Grid.Column="0" Placeholder="Item Name" Text="{Binding NewProductName}" TextColor="#FFFFFF" BackgroundColor="#0F172A" />
                            <Entry Grid.Column="1" Placeholder="Price" Text="{Binding NewProductPriceText}" Keyboard="Numeric" TextColor="#FFFFFF" BackgroundColor="#0F172A" />
                            <Button Grid.Column="2" Text="Add" Command="{Binding AddProductCommand}" BackgroundColor="#2563EB" TextColor="#FFFFFF" CornerRadius="6" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#334155" Margin="0,4" />

                        <!-- Customer Form -->
                        <Label Text="Register Customer" TextColor="#94A3B8" FontSize="11" />
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                            <Entry Grid.Column="0" Placeholder="Full Name" Text="{Binding NewCustomerName}" TextColor="#FFFFFF" BackgroundColor="#0F172A" />
                            <Entry Grid.Column="1" Placeholder="Phone" Text="{Binding NewCustomerPhone}" Keyboard="Telephone" TextColor="#FFFFFF" BackgroundColor="#0F172A" />
                            <Button Grid.Column="2" Text="Add" Command="{Binding AddCustomerCommand}" BackgroundColor="#2563EB" TextColor="#FFFFFF" CornerRadius="6" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= RIGHT PANE: ANALYTICS & LEDGER ================= -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="12">

            <!-- KPI METRIC CARDS -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,Auto" ColumnSpacing="12">

                <!-- Metric 1: Revenue -->
                <Border Grid.Column="0" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="TOTAL REVENUE" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                        <Label Text="{Binding TotalIncome, StringFormat='{0:C}'}" TextColor="#4ADE80" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- Metric 2: Orders Count -->
                <Border Grid.Column="1" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="TRANSACTIONS" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                        <Label Text="{Binding TotalTransactions}" TextColor="#F8FAFC" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- Metric 3: Master Totals -->
                <Border Grid.Column="2" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="DATABASE MASTERS" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                        <Label Text="{Binding TotalProducts, StringFormat='Products: {0}'}" TextColor="#E2E8F0" FontSize="12" />
                        <Label Text="{Binding TotalCustomers, StringFormat='Customers: {0}'}" TextColor="#E2E8F0" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Action: PDF Export -->
                <Button Grid.Column="3" Text="Generate PDF Ledger" Command="{Binding PrintPdfCommand}"
                        BackgroundColor="#4F46E5" TextColor="#FFFFFF" FontAttributes="Bold" CornerRadius="8" Padding="16,0" />
            </Grid>

            <!-- TABLE HEADER -->
            <Border Grid.Row="1" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="3*,3*,*,2*,2*">
                    <Label Grid.Column="0" Text="CUSTOMER" TextColor="#94A3B8" FontAttributes="Bold" FontSize="11" />
                    <Label Grid.Column="1" Text="PRODUCT" TextColor="#94A3B8" FontAttributes="Bold" FontSize="11" />
                    <Label Grid.Column="2" Text="QTY" TextColor="#94A3B8" FontAttributes="Bold" FontSize="11" />
                    <Label Grid.Column="3" Text="TOTAL" TextColor="#94A3B8" FontAttributes="Bold" FontSize="11" />
                    <Label Grid.Column="4" Text="TRANSACTION DATE" TextColor="#94A3B8" FontAttributes="Bold" FontSize="11" HorizontalTextAlignment="End" />
                </Grid>
            </Border>

            <!-- DATA TABLE -->
            <Border Grid.Row="2" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 6" Padding="4">
                <CollectionView ItemsSource="{Binding ReportItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:IncomeReportItem">
                            <Border Stroke="Transparent" BackgroundColor="#1E293B" Padding="8,10">
                                <Grid ColumnDefinitions="3*,3*,*,2*,2*">
                                    <Label Grid.Column="0" Text="{Binding CustomerName}" TextColor="#F8FAFC" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding ProductName}" TextColor="#CBD5E1" />
                                    <Label Grid.Column="2" Text="{Binding Quantity}" TextColor="#94A3B8" />
                                    <Label Grid.Column="3" Text="{Binding TotalAmount, StringFormat='{0:C}'}" TextColor="#4ADE80" FontAttributes="Bold" />
                                    <Label Grid.Column="4" Text="{Binding SoldAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}" TextColor="#64748B" HorizontalTextAlignment="End" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>