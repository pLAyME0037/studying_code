<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="user_info.Views.SimpleDialogPage"
             BackgroundColor="#80000000"> <!-- Semi-transparent background -->

    <Grid VerticalOptions="Center" HorizontalOptions="Center">
        <Border StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#2B2B2B}"
                Padding="24"
                WidthRequest="320">
            <VerticalStackLayout Spacing="16">
                <Label x:Name="TitleLabel" FontSize="18" FontAttributes="Bold" />
                <Label x:Name="MessageLabel" FontSize="14" TextColor="Gray" />
                <Button Text="OK" Clicked="OnOkClicked" HorizontalOptions="End" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
