<section class="px-4 py-3 max-w-5xl"><p class="text-xs text-gray-500 dark:text-gray-400 mb-2">ឯកសារ PDF/DOCX បង្កើតតាមរយៈ LibreOffice · A4 · ភាសាខ្មែរ</p><table class="w-full text-sm border border-gray-200 dark:border-gray-700"><thead><tr class="bg-slate-100 dark:bg-slate-800 text-xs uppercase tracking-wide text-slate-500"><th class="px-2 py-1.5 text-left">របាយការណ៍</th><th class="px-2 py-1.5 text-left">ID</th><th class="px-2 py-1.5 text-left">ទម្រង់</th></tr></thead><tbody>({ for (size_t i = 0; i < report_registry_count; ++i) { })({ const Report_Def *rep = &report_registry[i]; })<tr class="border-t border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800/60"><td class="px-2 py-1.5">({ ESCAPED(rep->khmer_title); })</td><td class="px-2 py-1.5 font-mono text-xs">({ STR(rep->id); })</td><td class="px-2 py-1.5"><a class="text-indigo-600 hover:underline font-medium" href="/reports/({ STR(rep->id); }).pdf">PDF</a><span class="text-gray-300 dark:text-gray-600 mx-1">·</span><a class="text-indigo-600 hover:underline font-medium" href="/reports/({ STR(rep->id); }).docx">DOCX</a></td></tr>({ } })</tbody></table></section>