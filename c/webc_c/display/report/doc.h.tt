<c> } </c><c> if (has_num && n_rows > 0) { bool lbl = false; </c><tr bgcolor="#e5e7eb"><c> for (int ci = 0; ci < ncols; ++ci) { if (!is_num[ci]) { if (!lbl) { </c><c> lbl = true; </c><td><b>សរុប</b></td><c> } else { </c><td></td><c> } </c><c> } else { </c><td class="num"><b><c> STR(totals_str[ci]); </c></b></td><c> } </c><c> } </c></tr>
<c> } </c></tbody></table></body></html>
