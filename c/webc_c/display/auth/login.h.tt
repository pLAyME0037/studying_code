<!-- /login - sign-in form. The error banner and the next round-trip are
     code state, so the page lives in a template (design rule:
     wiki/templates.md). Host: render_login() in src/auth/auth.c. Width is
     auto - no max-w clamp, only page padding. -->
<div class="min-h-screen flex items-center justify-center bg-base px-4 sm:px-6 lg:px-8 py-6">
    <form method="POST" action="/login" data-login-form class="w-full bg-mantle border border-surface0">
        <div class="bg-text text-onbase px-3 py-2">
            <div class="text-sm font-semibold">({ ESCAPED(tr("auth.title", "កត់ឈ្មោះចូល")); })</div>
            <div class="text-xs text-onbase/70">POS Admin</div>
        </div>
        <div class="px-3 py-3 flex flex-col gap-3">
({ if (err && err[0]) { })
            <div data-login-error class="bg-red/10 border-l-2 border-red text-red px-2 py-1.5 text-xs">({ ESCAPED(err); })</div>
({ } })
            <label class="text-xs text-subtext0">({ ESCAPED(tr("auth.label_username", "ឈ្មោះអ្នកប្រើ")); })</label>
            <input name="username" autocomplete="username" required class="border border-surface0 bg-base text-text px-2 py-1.5 text-sm w-full">
            <label class="text-xs text-subtext0">({ ESCAPED(tr("auth.label_password", "ពាក្យសម្ងាត់")); })</label>
            <input name="password" type="password" autocomplete="current-password" required class="border border-surface0 bg-base text-text px-2 py-1.5 text-sm w-full">
            <input type="hidden" name="next" value="({ ESCAPED(nexts); })">
            <button type="submit" class="bg-blue text-onbase hover:brightness-90 px-2 py-1.5 text-sm w-full">({ ESCAPED(tr("auth.submit", "ចូល")); })</button>
            <a href="/" class="text-xs text-blue hover:underline text-center">({ ESCAPED(tr("auth.back", "ត្រឡប់ទៅហាង")); })</a>
            <a href="/signup" class="text-xs text-blue hover:underline text-center">({ ESCAPED(tr("auth.signup_link", "បង្កើតគណនីថ្មី")); })</a>
        </div>
    </form>
</div>
