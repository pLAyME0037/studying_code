<!-- /accounts - multi-account switcher. Row state (current vs switchable)
     is code state, so the shell and the row loop live in a template
     (design rule: wiki/templates.md). Host: render_accounts() in
     src/auth/auth.c passes the Acct_Row array. Width is auto - no max-w
     clamp, only page padding. -->
<div class="min-h-screen bg-base px-4 sm:px-6 lg:px-8 py-6">
    <div class="w-full bg-mantle border border-surface0">
        <div class="bg-text text-onbase px-3 py-2 flex items-center justify-between">
            <div>
                <div class="text-sm font-semibold">({ ESCAPED(tr("auth.acct_title", "គណនី")); })</div>
                <div class="text-xs text-onbase/70">({ ESCAPED(tr("auth.acct_sub", "ចូលហើយក្នុងកម្មវិធីនេះ")); })</div>
            </div>
            <a href="/" class="text-xs text-onbase/80 hover:underline">Store</a>
        </div>
        <ul class="divide-y divide-surface0">
({ for (size_t i = 0; i < naccts; ++i) { })
({ const Acct_Row *a = &accts[i]; })
            <li class="flex items-center gap-3 px-3 py-2.5">
                <span class="h-9 w-9 rounded-full bg-surface1 text-subtext0 inline-flex items-center justify-center text-sm font-semibold shrink-0">({ ESCAPED(a->name[0] ? temp_sprintf("%c", a->name[0]) : "?"); })</span>
                <div class="min-w-0 flex-1">
                    <div class="text-sm text-text truncate">({ ESCAPED(a->name); })</div>
                    <div class="text-xs text-subtext0 truncate">({ ESCAPED(a->mail); })({ if (a->type[0]) { }) &#183; ({ ESCAPED(a->type); })({ } })</div>
                </div>
({ if (a->is_me) { })
                <span class="text-xs text-blue border border-blue/40 px-2 py-1 whitespace-nowrap">({ ESCAPED(tr("auth.acct_current", "ឥឡូវនេះ")); })</span>
({ } else { })
                <form method="POST" action="/switch" class="flex items-center gap-1.5">
                    <input type="hidden" name="sid" value="({ ESCAPED(a->sid); })">
                    <input type="hidden" name="next" value="/accounts">
                    <button name="op" value="switch" class="text-xs bg-blue text-onbase px-2 py-1">({ ESCAPED(tr("auth.acct_switch", "ប្តូរ")); })</button>
                    <button name="op" value="remove" class="text-xs text-red border border-surface0 px-2 py-1">({ ESCAPED(tr("auth.acct_remove", "លុប")); })</button>
                </form>
({ } })
            </li>
({ } })
        </ul>
        <div class="p-3 flex items-center justify-between text-xs">
            <a href="/login?next=/accounts" class="text-blue hover:underline">({ ESCAPED(tr("auth.acct_add", "បន្ថែមគណនី")); })</a>
            <a href="/logout" class="text-red hover:underline">({ ESCAPED(tr("shop.logout_link", "ចេញ")); })</a>
        </div>
    </div>
</div>
