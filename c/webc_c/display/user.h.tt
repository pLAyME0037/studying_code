                </th>
                <th class="<c> STR(th_class) </c>">
                    Action
                </th>
            </tr>
        </thead>
        <tbody id="<c> STR(page_container); </c>" class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800">
<c> } </c>
        <c> if (users.count != 0) { </c>
            <c> for (size_t i = 0; i < users.count; ++i) { </c>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                <div class="flex flex-col gap-1 items-start">
                    <td class="px-6 py-4 whitespace-nowrap dark:text-white text-left">
                        <c> STR(users.items[i].id) </c>
                    </td>
                </div>
                <div class="flex flex-col gap-1 items-center">
                    <td class="px-6 py-4 whitespace-nowrap text-left">
                        <c> const char *pp = users.items[i].profile_pic; bool has_pic = pp != NULL && pp[0] != '\0'; </c>
                        <div class="w-10 h-10 relative rounded-full ring-4 ring-white dark:ring-gray-800 shadow-sm bg-gray-100 dark:bg-gray-700 group">
                            <img src="<c> if (has_pic) { STR(pp); } else { nob_sb_append_cstr(sb, "https://ui-avatars.com/api/?name="); ESCAPED(users.items[i].name); nob_sb_append_cstr(sb, "&color=7F9CF5&background=EBF4FF&bold=true"); } </c>"
                                 alt="<c> ESCAPED(users.items[i].profile_pic) </c>"
                                 class="w-full h-full rounded-full object-cover transition-opacity duration-300 opacity-50">
                        </div>
                    </td>
                </div>
                <div class="flex flex-col gap-1 items-center">
                    <td class="px-6 py-4 whitespace-nowrap dark:text-white text-left">
                        <c> ESCAPED(users.items[i].name) </c>
                    </td>
                </div>
                <div class="flex flex-col gap-1 items-center">
                    <td class="px-6 py-4 whitespace-nowrap dark:text-white text-left">
                        <c> ESCAPED(users.items[i].username) </c>
                    </td>
                </div>
                <div class="flex flex-col gap-1 items-end">
                    <td class="px-6 py-4 whitespace-nowrap dark:text-white text-left">
                        <c> ESCAPED(users.items[i].email) </c>
                    </td>
                </div>
                <div class="flex flex-col gap-1 items-end">
                    <td class="px-6 py-4 whitespace-nowrap dark:text-white text-left">
                        <c> ESCAPED(users.items[i].phone) </c>
                    </td>
                </div>
                <div class="flex flex-col gap-1 items-end">
                    <td class="px-6 py-4 whitespace-nowrap text-left">
                        <a href="/users/<c> STR(users.items[i].id); </c>/edit"
