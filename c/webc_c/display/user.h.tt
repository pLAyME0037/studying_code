<c> if (!fragment) { </c>
<form method="POST" action="/users/create" enctype="multipart/form-data"
      class="mb-4 flex-col gap-2 items-end bg-white dark:bg-gray-800 p-4 rounded-lg border border-gray-200 dark:border-gray-700">
    <div>
        <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">
            Name
        </label>
        <input name="name" type="text" required
               class="border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white p-1.5 rounded-xs border">
    </div>
    <div>
        <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">
            Username
        </label>
        <input name="username" type="text" required
               class="border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white p-1.5 rounded-xs border">
    </div>
    <div>
        <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">
            Email
        </label>
        <input name="email" type="text" required
               class="border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white p-1.5 rounded-xs border">
    </div>
    <div>
        <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">
            Phone
        </label>
        <input name="phone" type="text" required
               class="border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white p-1.5 rounded-xs border">
    </div>
    <div>
        <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">
            Profile Pic
        </label>
        <input name="profile_pic" type="file" accept="image/png,image/jpeg,image/gif,image/webp"
               class="text-sm text-gray-600 dark:text-gray-300 file:mr-3 file:px-3 file:py-1.5 file:rounded file:border-0 file:bg-indigo-600 file:text-white file:cursor-pointer">
    </div>
    <button type="submit"
            class="px-4 py-2 rounded bg-indigo-600 hover:bg-indigo-700 text-white font-medium">
        Add user
    </button>
</form>
<c> } </c>

<c> if (fragment) { </c>
<div id="pg-store" hidden>
    <table data-pg-rows="<c> STR(page_container); </c>" data-pg-unit="1">
        <tbody>
<c> } else { </c>
<div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-700">
            <tr>
                <c> const char *th_class = "px-6 py-3 text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider w-auto text-left"; </c>
                <th class="<c> STR(th_class) </c>">
                    #
                </th>
                <th class="<c> STR(th_class) </c>">
                    Profile
                </th>
                <th class="<c> STR(th_class) </c>">
                    Name
                </th>
                <th class="<c> STR(th_class) </c>">
                    Username
                </th>
                <th class="<c> STR(th_class) </c>">
