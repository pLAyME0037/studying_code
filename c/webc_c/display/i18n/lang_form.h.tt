<form method="GET" action="/lang" data-lang-form class="flex items-center gap-1"><input type="hidden" name="back" value="({ ESCAPED(back); })"><select name="code" onchange="this.form.submit()" aria-label="Language" class="border border-surface0 bg-mantle text-text px-1 py-1.5 text-xs">({ for (size_t i = 0; i < g_i18n.nlangs; ++i) { })({ Lang_Row *L = &g_i18n.langs[i]; })<option value="({ ESCAPED(L->code); })"({ if (strcmp(L->code, g_i18n.active) == 0) { }) selected({ } })>({ ESCAPED(L->name[0] ? L->name : L->code); })</option>({ } })</select><noscript><button type="submit" class="border border-surface0 bg-mantle text-text px-1 py-1.5 text-xs">&#8629;</button></noscript></form>