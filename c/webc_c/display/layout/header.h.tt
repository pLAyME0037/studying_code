<!DOCTYPE html>
<html lang="({ STR(HTML_LANG); })">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Example WebC Site - ({ STR(PAGE_TITLE); })</title>
    <link href="/css/output.css" rel="stylesheet">
    <script src="/js/sidebarSwitcher.js">
        (function () {
            const isCollapsed = localStorage.getItem('sidebar_collapsed') === 'true';
            if (isCollapsed) {
              document.documentElement.classList.add('sidebar-collapsed');
            }
        })();
    </script>
    <script src="/js/themeSwitcher.js"></script>
    <script src="/js/ListExpandSwitcher.js"></script>
    <script src="/js/PaginationSwitcher.js"></script>

    <style>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body class="h-full bg-base text-text transition-colors duration-300">
    <div class="flex flex-col h-screen">
        <header class="shrink-0 sticky top-0 z-30 bg-mantle shadow-sm border-b border-surface0">
            <div class="flex items-center justify-between px-4 py-1">

                <div class="flex items-center gap-2">
                    <button data-sidebar-toggle 
                            class="p-2 -ml-2 rounded-lg text-subtext0 hover:bg-surface0 focus:outline-none focus:ring-2 focus:ring-blue">
                        <svg class="w-6 h-6" 
                             fill="none" 
                             stroke="currentColor" 
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round" 
                                  stroke-linejoin="round" 
                                  stroke-width="2"
                                  d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>

                    <div class="hidden md:flex items-center gap-2">
                        <span class="font-bold text-xl text-text tracking-tight">
                            Clinic
                        </span>
                    </div>

                    <div class="h-6 w-px bg-surface1 mx-2 hidden md:block"></div>

                    <h1 class="text-lg font-semibold text-text truncate">
                        ({ STR(PAGE_TITLE); })
                    </h1>
                </div>

                <div class="flex items-center space-x-3">
                    <div class="flex items-center gap-1">
                        ({ {
                            char *theme_btn = "px-2 py-1 rounded text-sm text-subtext0 hover:bg-surface0 hover:text-text"; })
                            <button onclick="window.themeController.setTheme('light')"
                                    class="({ STR(theme_btn); })">
                                Light
                            </button>
                            <button onclick="window.themeController.setTheme('dark')"
                                    class="({ STR(theme_btn); })">
                                Dark
                            </button>
                            <button onclick="window.themeController.setTheme('device')"
                                    class="({ STR(theme_btn); })">
                                System
                            </button>
                        ({ } })
                    </div>
                    <div class="flex items-center gap-1">
                        ({ STR(LANG_FORM); })
                    </div>
                </div>
            </div>
        </header>

        <div class="flex-1 flex overflow-hidden relative min-h-0">
            ({ #include "../component/sidebar.h" })

            <div class="flex-1 flex flex-col min-w-0">
                <main class="flex-1 overflow-y-auto flex flex-col min-w-0 bg-base">
                    <div class="flex-1 py-6 px-4 sm:px-6 lg:px-8">
