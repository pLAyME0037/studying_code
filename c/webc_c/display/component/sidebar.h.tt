<aside id="sidebar"
       class="shrink-0 flex flex-col border-r border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 transition-all duration-300 h-full">

    <div class="border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 shrink-0">
        <div id="sidebar-pad"
             class="flex items-center p-3 user-card">
            <img src="({ STR(u.profile_pic); })"
                 alt="({ STR(u.name); })"
                 class="h-10 w-10 rounded-full shrink-0" />
            <div class="ml-3 min-w-0 nav-label">
                <p class="text-sm font-semibold text-gray-800 dark:text-white truncate">
                    ({ STR(u.name); })
                </p>
                <p class="text-xs text-gray-500 dark:text-gray-400 truncate">
                    ({ STR(u.email); })
                </p>
            </div>
        </div>

        <div class="sidebar-tooltip">
            ({ STR(u.name); })
        </div>
    </div>

    <nav class="flex-1 py-0 px-3 space-y-1 overflow-y-auto no-scrollbar">
        ({ for (size_t ni = 0; ni < nav_items_count; ++ni) { })
        ({ if (nav_items[ni].group != NULL) { })
