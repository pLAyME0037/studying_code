            ({ STR(nav_items[ni].group); })
        </div>
        ({ } })
        <div class="relative group/item mb-1">
            <a href="({ STR(nav_items[ni].path); })"
               class="nav-link flex items-center transition-all duration-200 ease-in-out p-2 ({ CLS(NAV_ACTIVE(nav_items[ni].path) &&
                   (strcmp(nav_items[ni].path, "/") != 0 || strcmp(CURRENT_PATH, "/") == 0),
                   "bg-indigo-50 text-indigo-600 dark:bg-indigo-900/50 dark:text-indigo-300",
                   "text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-200") })">
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="({ STR(nav_items[ni].icon); })" />
                </svg>
                <span class="ml-3 text-sm font-medium whitespace-nowrap flex-1 nav-label">
                    ({ STR(nav_items[ni].label); })
                </span>
            </a>
            <div class="sidebar-tooltip">
                ({ STR(nav_items[ni].label); })
            </div>
        </div>
        ({ } })
    </nav>

    <div id="sidebar-pad" class="border-t border-gray-200 dark:border-gray-700 shrink-0">
