<c> if (!fragment) { </c>
<div id="mc-root" class="max-w-full mx-auto">
    <!-- View strip: Live + Trash on soft_delete pages. The dedicated
         search row below it (?q text, ?qcol scope) filters whichever
         view is active. orders hides Live + the add form
         (MD_MasterConfig.no_live/no_create: rows come from sales). -->
    <c> if (config->soft_delete) { </c>
    <div class="mb-2 inline-flex text-sm border border-gray-200 dark:border-gray-700 divide-x divide-gray-200 dark:divide-gray-700">
        <c> if (!config->no_live) { </c>
        <a href="<c> STR(md_path); </c>"
           title="Plain list of live rows"
           class="px-2 py-1.5 font-medium <c> if (!show_deleted) { </c>bg-blue text-onbase<c> } else { </c>text-subtext0 hover:text-text hover:bg-surface0<c> } </c>">
            Live</a>
        <c> } </c>
        <a href="<c> STR(md_path); </c>?deleted=1"
           title="Soft-deleted rows - restore or leave them here"
           class="px-2 py-1.5 font-medium <c> if (show_deleted) { </c>bg-red text-onbase<c> } else { </c>text-subtext0 hover:text-text hover:bg-surface0<c> } </c>">
            Trash (<span data-trash-total><c> INT(trash_total); </c></span>)</a>
    </div>
    <c> } </c>
    <!-- The per-column filter row lives inside the table's header row;
         its inputs post into this empty anchor form via the form
         attribute. -->
    <form id="md-query-form" method="GET" action="<c> STR(md_path); </c>"></form>
    <script>
    (function () {
        var boxes = document.querySelectorAll('[data-md-qbox]');
        if (!boxes.length) return;
        var f = document.getElementById('md-query-form');
        var timer;
        function kick() {
            clearTimeout(timer);
            timer = setTimeout(function () { f.submit(); }, 400);
        }
        for (var i = 0; i < boxes.length; ++i) {
            boxes[i].addEventListener('input', kick);
            boxes[i].addEventListener('change', kick);
        }
        for (var j = 0; j < boxes.length; ++j) {
            if (boxes[j].value) {
                boxes[j].focus();
                if (boxes[j].tagName === 'INPUT') {
                    boxes[j].setSelectionRange(boxes[j].value.length,
                                               boxes[j].value.length);
                }
                break;
            }
        }
    </c>();
    </script>
<c> if (show_deleted) { </c>
    <div class="mb-3 px-2 py-1 flex justify-between items-center text-sm bg-red-50 dark:bg-red-900 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300">
        <span>Deleted rows &mdash; restore to bring them back, or leave them here.</span>
        <a href="<c> STR(md_path); </c>" class="underline">Back to list</a>
    </div>
<c> } </c>
<c> if (!config->read_only && !config->no_create && !show_deleted) { </c>
