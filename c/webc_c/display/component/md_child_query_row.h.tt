<tr class="border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
    ({ for (size_t ci = 0; ci < config->column_count; ++ci) { })
    ({ const MD_Column *fcol = &config->columns[ci]; })
    <td class="pl-3 py-1">
        ({ if (fcol->name && md_col_queryable(fcol)) { })
        ({ String_View cbox = sv_from_cstr("");
           form_find(query, temp_sprintf("q_%s", fcol->name), &cbox);
           String_View shown = cbox.count ? cbox
               : (qcol_name[0] && strcmp(qcol_name, fcol->name) == 0
                  ? sv_from_cstr(q_text) : sv_from_cstr("")); })
        <input type="search" name="q_({ STR(fcol->name); })"
               form="md-query-form" data-md-qbox
               value="({ ESCAPED(temp_sprintf("%.*s", (int)shown.count, shown.data)); })"
               placeholder="({ ESCAPED(fcol->label); })"
               aria-label="Search ({ ESCAPED(fcol->label); })"
               class="w-full px-1 py-0.5 text-xs border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
        ({ } })
    </td>
    ({ } })
    <td class="pl-3 py-1">
        <div class="flex items-center gap-1">
            <input type="search" name="q" form="md-query-form" data-md-qbox
                   value="({ ESCAPED(qcol_name[0] ? "" : q_text); })"
                   placeholder="All..." aria-label="Search all columns"
                   class="w-full px-1 py-0.5 text-xs border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white min-w-0">
            <button type="submit" form="md-query-form"
                    title="Search" aria-label="Search"
                    class="shrink-0 text-gray-500 hover:text-gray-900 dark:hover:text-white">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
            </button>
            ({ if (search_active) { })
            <a href="({ STR(md_path); })" title="Clear the search"
               class="shrink-0 px-1 text-xs text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">&#10005;</a>
            ({ } })
        </div>
    </td>
</tr>
