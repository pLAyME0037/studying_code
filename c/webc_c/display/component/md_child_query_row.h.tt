<form id="md-query-form" method="GET" action="({ STR(md_path); })"
      data-md-query="1"
      class="mb-2 flex flex-wrap items-center gap-1.5">
    <label for="md-query-q"
           class="text-xs font-medium text-gray-500 dark:text-gray-400">Search</label>
    <select id="md-query-col" name="qcol" aria-label="Search column"
            class="px-1 py-1 text-xs border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
        <option value="">All columns</option>
        ({ for (size_t ci = 0; ci < config->column_count; ++ci) { })
        ({ if (config->columns[ci].name && md_col_queryable(&config->columns[ci])) { })
        <option value="({ STR(config->columns[ci].name); })"({ if (qcol_name[0] && strcmp(qcol_name, config->columns[ci].name) == 0) { })selected({ } })>({ ESCAPED(config->columns[ci].label); })</option>
        ({ } })
        ({ } })
    </select>
    <input id="md-query-q" type="search" name="q"
           value="({ ESCAPED(q_text); })"
           placeholder="Search ({ ESCAPED(config->title); })..."
           class="px-1 py-1 text-xs border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white flex-1 min-w-[140px]">
    <button type="submit"
            class="px-2 py-1 text-xs font-medium text-gray-500 hover:text-gray-900 dark:hover:text-white border-b-2 border-gray-300 dark:border-gray-600 hover:border-b-blue-700">
        Search
    </button>
    ({ if (q.count > 0) { })
    <a href="({ STR(md_path); })"
       title="Clear the search"
       class="px-1.5 py-1 text-xs text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">&#10005;</a>
    ({ } })
</form>
<script>
(function () {
    var f = document.getElementById('md-query-form');
    if (!f) return;
    var box = f.querySelector('input[name="q"]');
    var timer;
    box.addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(function () { f.submit(); }, 400);
    });
    f.querySelector('select[name="qcol"]').addEventListener('change', function () {
        f.submit();
    });
    if (box.value) {
        box.focus();
        box.setSelectionRange(box.value.length, box.value.length);
    }
})();
</script>
