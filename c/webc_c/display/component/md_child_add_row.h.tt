<tr class="md-add-row hidden">
    <c>
    for (size_t cci = 0; cci < config->children[ti].column_count; ++cci) {
    </c>
    <td class="p-1">
        <c> if (config->children[ti].columns[cci].computed) { </c>
        <c> } else if (config->children[ti].columns[cci].cell) { </c>
        <div class="flex flex-col gap-1">
            <c> for (size_t pi = 0; pi < config->children[ti].columns[cci].cell->part_count; ++pi) { </c>
            <label class="block text-xs text-gray-500 dark:text-gray-400">
                <c> ESCAPED(md_cell_part_label(config->children[ti].columns[cci].cell, pi)); </c>
            </label>
            <c> if (config->children[ti].columns[cci].cell->part_choices
                   && config->children[ti].columns[cci].cell->part_choices[pi]) { </c>
            <select form="mdf-a-<c> STR(config->children[ti].table); </c>-<c> STR(rows->items[ri].id); </c>"
                    name="<c> ESCAPED(config->children[ti].columns[cci].cell->parts[pi]); </c>"
                    class="w-full px-0.5 py-1.5 text-sm border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                <c> for (size_t o = 0;
                        config->children[ti].columns[cci].cell->part_choices[pi][o];
                        ++o) { </c>
                <option value="<c> STR(config->children[ti].columns[cci].cell->part_choices[pi][o]); </c>">
                    <c> ESCAPED(config->children[ti].columns[cci].cell->part_choices[pi][o]); </c>
                </option>
                <c> } </c>
            </select>
            <c> } else { </c>
            <input form="mdf-a-<c> STR(config->children[ti].table); </c>-<c> STR(rows->items[ri].id); </c>"
                   name="<c> ESCAPED(config->children[ti].columns[cci].cell->parts[pi]); </c>"
                   type="text"
                   class="w-full px-0.5 py-1.5 text-sm border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            <c> } </c>
        <c> } </c>
        </div>
        <c> } else { </c>
        <label class="block text-sm text-gray-500 dark:text-gray-400">
            <c> ESCAPED(config->children[ti].columns[cci].label); </c>
        </label>
        <c> if (config->children[ti].columns[cci].type == COL_TYPE_FK_SELECT) { </c>
        <select form="mdf-a-<c> STR(config->children[ti].table); </c>-<c> STR(rows->items[ri].id); </c>"
                name="<c> STR(config->children[ti].columns[cci].name); </c>"
                <c> if (!config->children[ti].columns[cci].nullable) { </c>
                    required
                <c> } </c>
                class="w-full px-0.5 py-1.5 text-sm border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
            <c> if (config->children[ti].columns[cci].nullable) { </c>
            <option value="">None</option>
            <c> } </c>
            <c> for (size_t o = 0; o < config->children[ti].columns[cci].opt_count; ++o) { </c>
            <option value="<c> STR(config->children[ti].columns[cci].opt[o].id); </c>">
                <c> ESCAPED(config->children[ti].columns[cci].opt[o].label); </c>
            </option>
            <c> } </c>
        </select>
        <c> } else { </c>
        <input form="mdf-a-<c> STR(config->children[ti].table); </c>-<c> STR(rows->items[ri].id); </c>"
               name="<c> STR(config->children[ti].columns[cci].name); </c>"
               type="<c> if (config->children[ti].columns[cci].type == COL_TYPE_DATE) { </c>
                        date
                     <c> } else if (config->children[ti].columns[cci].type == COL_TYPE_NUM) { </c>
                        number
                     <c> } else { </c>
                        text
                     <c> } </c>"
               <c> if (config->children[ti].columns[cci].type == COL_TYPE_NUM) { </c>step="any" <c> } </c>
               <c> if (!config->children[ti].columns[cci].nullable
                      && config->children[ti].columns[cci].type != COL_TYPE_DATE) { </c>required<c> } </c>
               class="w-full px-0.5 py-1.5 text-sm border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
        <c> } </c>
    <c> } </c>
    </td>
    <c> } </c>
    <td class="p-1">
        <div class="flex flex-col gap-1 items-start">
            <button type="submit" form="mdf-a-<c> STR(config->children[ti].table); </c>-<c> STR(rows->items[ri].id); </c>"
                    title="Confirm" aria-label="Confirm"
                    class="p-1 text-green-600 hover:bg-green-100 dark:hover:bg-green-900/40">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </button>
            <button type="button" class="md-discard p-1 text-gray-500 hover:bg-gray-200 dark:hover:bg-gray-700"
                    title="Discard" aria-label="Discard">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
    </td>
</tr>
