<div class="bg-mantle border border-surface0 flex flex-col md:flex-row"><div class="bg-blue/10 md:w-64 h-40 flex items-center justify-center text-blue font-bold text-5xl">({ sb_append_first_glyph(&content, name); })</div><div class="flex-1 px-3 py-3 flex flex-col gap-2"><div class="text-xs text-overlay0">SKU: ({ ESCAPED(sku); }) · ({ ESCAPED(cat); })</div><h1 class="text-xl font-semibold text-text">({ ESCAPED(name); })</h1><div class="text-2xl font-bold text-blue">({ STR(shop_money(price)); })</div><div class="text-sm ({ if (out) { })text-red">({ ESCAPED(tr("shop.out_of_stock", "អស់ពីរាក់")); })({ } else { })text-green">({ ESCAPED(tr("shop.in_stock", "នៅសល់: ")); })({ sb_appendf(&content, "%d", stock_i); })({ } })</div>({ if (out) { })<div class="bg-red/10 border-l-2 border-red text-red px-2 py-1.5 text-xs">({ ESCAPED(tr("shop.out_notice", "ផលិតផលនេះអស់ពីរាក់")); })</div>({ } else { })<div class="flex items-center gap-2"><form method="POST" action="/cart/add" class="flex items-center gap-2"><input type="hidden" name="product_id" value="({ ESCAPED(id_s); })"><input type="hidden" name="redirect" value="/product/({ ESCAPED(id_s); })"><input type="number" name="qty" value="1" min="1" max="({ sb_appendf(&content, "%d", stock_i); })" class="border border-surface0 bg-mantle text-text px-2 py-1.5 text-sm w-20"><button class="bg-blue text-onbase hover:brightness-90 px-2 py-1.5 text-sm">({ ESCAPED(tr("shop.add_to_cart", "ដាក់ក្នុងរទេះ")); })</button></form><form method="POST" action="/cart/buynow" class="flex items-center gap-2"><input type="hidden" name="product_id" value="({ ESCAPED(id_s); })"><button class="bg-mauve text-onbase hover:brightness-90 px-2 py-1.5 text-sm">({ ESCAPED(tr("shop.buy_now", "ទិញឥឡូវនេះ")); })</button></form></div>({ } })<a href="/" class="text-xs text-blue hover:underline mt-1">({ ESCAPED(tr("shop.back_list", "« ត្រឡប់ទៅបញ្ជីផលិតផល")); })</a></div></div>