<div class="bg-mantle border border-surface0 flex flex-col md:flex-row"><div class="bg-blue/10 md:w-64 h-40 flex items-center justify-center text-blue font-bold text-5xl"><c> sb_append_first_glyph(&content, name); </c></div><div class="flex-1 px-3 py-3 flex flex-col gap-2"><div class="text-xs text-overlay0">SKU: <c> ESCAPED(sku); </c> · <c> ESCAPED(cat); </c></div><h1 class="text-xl font-semibold text-text"><c> ESCAPED(name); </c></h1><div class="text-2xl font-bold text-blue"><c> STR(shop_money(price)); </c></div><div class="text-sm <c> if (out) { </c>text-red"><c> ESCAPED(tr("shop.out_of_stock", "អស់ពីរាក់")); </c><c> } else { </c>text-green"><c> ESCAPED(tr("shop.in_stock", "នៅសល់: ")); </c><c> sb_appendf(&content, "%d", stock_i); </c><c> } </c></div><c> if (out) { </c><div class="bg-red/10 border-l-2 border-red text-red px-2 py-1.5 text-xs"><c> ESCAPED(tr("shop.out_notice", "ផលិតផលនេះអស់ពីរាក់")); </c></div><c> } else { </c><div class="flex items-center gap-2"><form method="POST" action="/cart/add" class="flex items-center gap-2"><input type="hidden" name="product_id" value="<c> ESCAPED(id_s); </c>"><input type="hidden" name="redirect" value="/product/<c> ESCAPED(id_s); </c>"><input type="number" name="qty" value="1" min="1" max="<c> sb_appendf(&content, "%d", stock_i); </c>" class="border border-surface0 bg-mantle text-text px-2 py-1.5 text-sm w-20"><button class="bg-blue text-onbase hover:brightness-90 px-2 py-1.5 text-sm"><c> ESCAPED(tr("shop.add_to_cart", "ដាក់ក្នុងរទេះ")); </c></button></form><form method="POST" action="/cart/buynow" class="flex items-center gap-2"><input type="hidden" name="product_id" value="<c> ESCAPED(id_s); </c>"><button class="bg-mauve text-onbase hover:brightness-90 px-2 py-1.5 text-sm"><c> ESCAPED(tr("shop.buy_now", "ទិញឥឡូវនេះ")); </c></button></form></div><c> } </c><a href="/" class="text-xs text-blue hover:underline mt-1"><c> ESCAPED(tr("shop.back_list", "« ត្រឡប់ទៅបញ្ជីផលិតផល")); </c></a></div></div>
