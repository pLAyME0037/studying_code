<div class="min-h-screen flex flex-col bg-base"><header class="bg-mantle border-b border-surface0"><div class="max-w-5xl mx-auto px-3 py-2 flex items-center gap-2 flex-wrap"><a href="/" class="font-bold text-text whitespace-nowrap">({ ESCAPED(shop_name()); })</a><form method="GET" action="/" class="flex items-center gap-1 flex-1"><input name="q" placeholder="({ ESCAPED(tr("shop.search.placeholder", "ស្វែងរកផលិតផល...")); })" class="border border-surface0 bg-mantle text-text px-2 py-1.5 text-sm flex-1 min-w-0"><button class="bg-blue text-onbase hover:brightness-90 px-2 py-1.5 text-sm whitespace-nowrap">({ ESCAPED(tr("shop.search.button", "ស្វែងរក")); })</button></form><a href="/cart" class="text-sm text-text border border-surface0 px-2 py-1.5 whitespace-nowrap">({ ESCAPED(tr("shop.cart_link", "រទេះ")); }) ({ sb_append_cstr(sb, "("); sb_appendf(sb, "%zu", cart_entry_count(sc)); sb_append_cstr(sb, ")"); })</a>({ if (!signed_in || is_admin) { })<a href="/dashboard" class="text-sm text-blue whitespace-nowrap">({ ESCAPED(tr("shop.admin_link", "ផ្ទៃគ្រប់គ្រង")); })</a>({ } })({ if (signed_in) { })<span class="text-sm text-text px-1 whitespace-nowrap">({ ESCAPED(au->name && au->name[0] ? au->name : au->id); })</span><a href="/accounts" class="text-sm text-blue px-1 whitespace-nowrap">({ ESCAPED(tr("shop.accounts_link", "គណនី")); })</a><a href="/logout" class="text-sm text-text border border-surface0 px-2 py-1.5 whitespace-nowrap">({ ESCAPED(tr("shop.logout_link", "ចេញ")); })</a>({ } else { })<a href="/login" class="text-sm text-text border border-surface0 px-2 py-1.5 whitespace-nowrap">({ ESCAPED(tr("shop.signin_link", "ចូល")); })</a><a href="/signup" class="text-sm bg-blue text-onbase px-2 py-1.5 whitespace-nowrap">({ ESCAPED(tr("shop.signup_link", "ចុះឈ្មោះ")); })</a>({ } })<div class="flex items-center gap-0.5 text-xs" data-theme-switch><button type="button" data-set-theme="light" title="({ ESCAPED(tr("shop.theme_light", "ស្រាល")); })" onclick="window.themeController.setT