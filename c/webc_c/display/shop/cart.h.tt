<div class="bg-mantle border border-surface0"><div class="bg-text text-onbase px-3 py-2 flex items-center justify-between"><span class="text-sm font-semibold"><c> ESCAPED(tr("cart.title", "រទេះទំនិញ")); </c></span><a href="/" class="text-xs text-onbase/70 hover:text-onbase"><c> ESCAPED(tr("cart.continue", "បន្តទិញ")); </c></a></div><c> if (cart.count == 0) { </c><div class="text-center px-3 py-8"><div class="text-overlay0 text-sm"><c> ESCAPED(tr("cart.empty", "រទេះទំនិញទំនេរ")); </c></div><a href="/" class="text-xs text-blue hover:underline"><c> ESCAPED(tr("cart.view_products", "មើលផលិតផល")); </c></a></div><c> } else { </c><c> for (size_t i = 0; i < cart.count; ++i) { Shop_Cart_Item *it = &cart.items[i]; if (!it->valid) continue; </c><div data-cart-row class="px-3 py-2 border-b border-surface0 flex items-center gap-3"><div class="flex-1 min-w-0"><div class="text-sm font-medium text-text truncate"><c> ESCAPED(it->name); </c></div><div class="text-xs text-overlay0"><c> ESCAPED(it->sku); </c> · <c> STR(shop_money(it->price)); </c><c> if ((double) it->qty > it->stock) { </c> · <span class="text-red"><c> ESCAPED(tr("cart.low_stock", "ស្តុកមិនគ្រប់គ្រាន់")); </c></span><c> } </c></div></div><form method="POST" action="/cart/update" class="flex items-center gap-1"><input type="hidden" name="product_id" value="<c> ESCAPED(it->id); </c>"><input type="hidden" name="redirect" value="/cart"><input type="number" name="qty" value="<c> sb_appendf(&content, "%d", it->qty); </c>" min="0" class="border border-surface0 bg-mantle text-text px-1 py-1.5 text-sm w-16"><button class="border border-surface0 px-2 py-1.5 text-xs bg-mantle text-subtext0 hover:bg-surface0"><c> ESCAPED(tr("cart.edit", "កែ")); </c></button></form><div class="text-sm w-24 text-right font-medium"><c> STR(shop_money(it->price * it->qty)); </c></div><form method="POST" action="/cart/remove"><input type="hidden" name="product_id" value="<c> ESCAPED(it->id); </c>"><button class="text-red text-xs hover:underline"><c> ESCAPED(tr("cart.remove", "លុប")); </c></button></form></div><c> } </c><div class="px-3 py-2 flex items-center justify-between bg-surface0/50 border-t border-surface0"><span class="text-sm font-semibold text-text"><c> ESCAPED(tr("cart.subtotal", "សរុប")); </c></span><span class="text-sm font-semibold text-text"><c> STR(shop_money(cart.subtotal)); </c></span></div><div class="px-3 py-2 flex items-center justify-end gap-2 border-t border-surface0"><a href="/" class="border border-surface0 px-2 py-1.5 text-sm bg-mantle text-text hover:bg-surface0"><c> ESCAPED(tr("cart.continue", "បន្តទិញ")); </c></a><a href="/checkout" class="bg-blue text-onbase hover:brightness-90 px-2 py-1.5 text-sm"><c> ESCAPED(tr("cart.checkout", "បង់ប្រាក់")); </c></a></div><c> } </c></div>
