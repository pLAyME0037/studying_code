<div class="grid md:grid-cols-2 gap-3"><div class="bg-mantle border border-surface0 self-start"><div class="bg-text text-onbase px-3 py-2 text-sm font-semibold">({ ESCAPED(tr("checkout.order_title", "ការបញ្ជាទិញរបស់អ្នក")); })</div>({ for (size_t i = 0; i < cart->count; ++i) { const Shop_Cart_Item *it = &cart->items[i]; if (!it->valid) continue; })<div class="px-3 py-2 border-b border-surface0 flex items-center gap-2 text-sm"><div class="flex-1 min-w-0"><div class="text-text truncate">({ ESCAPED(it->name); })</div><div class="text-xs text-overlay0">({ ESCAPED(it->sku); }) × ({ sb_appendf(&content, "%d", it->qty); })</div></div><div class="text-text">({ STR(shop_money(it->price * it->qty)); })</div></div>({ } })<div class="px-3 py-2 flex items-center justify-between bg-surface0/50 border-t border-surface0 text-sm"><span class="font-semibold text-text">({ ESCAPED(tr("checkout.total", "សរុប")); })</span><span class="font-semibold text-text">({ STR(shop_money(cart->subtotal)); })</span></div></div><form method="POST" action="/checkout" data-checkout-form class="bg-mantle border border-surface0 px-3 py-3 flex flex-col gap-2">({ if (err && err[0]) { })<div data-checkout-error class="bg-red/10 border-l-2 border-red text-red px-2 py-1.5 text-xs">({ ESCAPED(err); })</div>({ } })<label class="text-xs text-subtext0">({ ESCAPED(tr("checkout.label_name", "ឈ្មោះ")); })</label><input name="name" required value="({ ESCAPED(sv_cstr(name)); })" class="border border-surface0 bg-base text-text px-2 py-1.5 text-sm"><label class="text-xs text-subtext0">({ ESCAPED(tr("checkout.label_phone", "លេខទូរស័ព្ទ")); })</label><input name="phone" required value="({ ESCAPED(sv_cstr(phone)); })" class="border border-surface0 bg-base text-text px-2 py-1.5 text-sm"><label class="text-xs text-subtext0">({ ESCAPED(tr("checkout.label_address", "អាសយដ្ឋាន")); })</label><input name="address" required value="({ ESCAPED(sv_cstr(addr)); })" class="border border-surface0 bg-base text-text px-2 py-1.5 text-sm"><label class="text-xs text-subtext0">({ ESCAPED(tr("checkout.label_note", "មតិ (ស្រេចចិត្ត)")); })</label><input name="note" value="({ ESCAPED(sv_cstr(note)); })" class="border border-surface0 bg-base text-text px-2 py-1.5 text-sm"><button class="bg-blue text-onbase hover:brightness-90 px-2 py-1.5 text-sm">({ ESCAPED(tr("checkout.submit", "បញ្ជាទិញ")); })</button></form></div>