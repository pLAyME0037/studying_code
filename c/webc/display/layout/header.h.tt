({
#define OUT(buf, size) sb_append_buf(sb, buf, size);
#define INT(x) sb_appendf(sb, "%d", (x));
#define STR(x) sb_append_cstr(sb, (x) ? (x) : "");
#define ESCAPED(x) sb_append_html_escaped(sb, (x) ? (x) : "");
})
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clinic - ({ STR(PAGE_TITLE); })</title>
    <link href="/css/output.css" rel="stylesheet">
    <script src="/js/sidebarSwitcher.js"></script>
    <script src="/js/themeSwitcher.js"></script>
    <script src="/js/ListExpandSwitcher.js"></script>

    <style>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body class="h-full bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-300">
    <div class="flex flex-col h-screen overflow-hidden">
        <header class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700 sticky top-0 z-30">
            <div class="flex items-center justify-between px-4 py-3">

                <div class="flex items-center gap-4">
                    <button onclick="window.sidebarController.toggle()"
                            class="p-2 -ml-2 rounded-lg text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <svg class="w-6 h-6" 
                             fill="none" 
                             stroke="currentColor" 
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round" 
                                  stroke-linejoin="round" 
                                  stroke-width="2"
                                  d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>

                    <div class="hidden md:flex items-center gap-2">
                        <span class="font-bold text-xl text-gray-800 dark:text-white tracking-tight">
                            Clinic
                        </span>
                    </div>

                    <div class="h-6 w-px bg-gray-300 dark:bg-gray-600 mx-2 hidden md:block"></div>

                    <h1 class="text-lg font-semibold text-gray-800 dark:text-white truncate">
                        ({ STR(PAGE_TITLE); })
                    </h1>
                </div>

                <div class="flex items-center space-x-3">
                    <div class="flex items-center gap-1">
                        ({ {
                            char *theme_btn = "px-2 py-1 rounded text-sm text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700"; })
                            <button onclick="window.themeController.setTheme('light')"
                                    class="({ STR(theme_btn); })">
                                Light
                            </button>
                            <button onclick="window.themeController.setTheme('dark')"
                                    class="({ STR(theme_btn); })">
                                Dark
                            </button>
                            <button onclick="window.themeController.setTheme('device')"
                                    class="({ STR(theme_btn); })">
                                System
                            </button>
                        ({ } })
                    </div>
                </div>
            </div>
        </header>

        <div class="flex-1 flex overflow-y-scroll relative">
            ({ #include "../component/sidebar.h" })

            <div class="flex-1 flex flex-col min-w-0">
<main class="flex-1 overflow-y-auto focus:outline-none bg-gray-100 dark:bg-gray-900 scrollbar-thin scrollbar-thumb-gray-300 dark:scrollbar-thumb-gray-700">

    <div class="py-6 px-4 sm:px-6 lg:px-8">
