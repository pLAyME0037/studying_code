<c>
    // Per-master child window. One shared ?<table>_page key (parsed once
    // per table into child_pages[] in serve_master_child); the totals are
    // per master, so the window is clamped against each master's own rows.
    Page_Info page_info = child_pages[ti];
    page_info_finish(&page_info, rows->items[ri].children[ti].count);
    size_t cw_lo = page_info.offset;
    size_t cw_hi = cw_lo + page_info.per_page;
    if (cw_hi > rows->items[ri].children[ti].count) {
        cw_hi = rows->items[ri].children[ti].count;
    }
    const char *page_key = temp_sprintf("%s_page", config->children[ti].table);
    const char *page_container = temp_sprintf("mc-tbody-%s-%s",
            config->children[ti].table, rows->items[ri].id);
    const char *page_base = md_path;
    String_View page_query = sc->query_string;
</c>
<div class="tab-content <c> if (ti == 0) { </c><c> } else { </c>hidden<c> } </c>"
     data-tab="<c> STR(config->children[ti].table); </c>"
     data-master-id="<c> STR(rows->items[ri].id); </c>">
    <div class="bg-slate-100 dark:bg-slate-900 border border-gray-200 dark:border-gray-700 flex justify-between items-center">
        <div class="flex items-center pl-3 gap-2">
            <h4 class="font-medium text-sm text-gray-800 dark:text-white">
                <c> ESCAPED(config->children[ti].title); </c>
            </h4>
            <span class="text-xs px-2 py-0.5 rounded bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-300">
                <c> STR(config->children[ti].fk_column); </c>: <c> STR(rows->items[ri].id); </c>
            </span>
        </div>
        <button type="button"
                title="Add"
                aria-label="Add"
                data-tab="<c> STR(config->children[ti].table); </c>"
                class="add-child-btn flex items-center gap-1 px-2 py-1 text-xs rounded text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-900/40">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        </button>
    </div>

    <table class="w-full text-left border-collapse text-sm">
        <thead class="bg-slate-100 dark:bg-slate-900 dark:text-white text-slate-800">
            <tr class="border border-gray-200 dark:border-gray-700">
                <c> for (size_t cci = 0; cci < config->children[ti].column_count; ++cci) { </c>
                    <th class="px-3 py-1.5 font-medium text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">
                        <c> ESCAPED(config->children[ti].columns[cci].label); </c>
                    </th>
                <c> } </c>
                <th class="px-3 py-1.5 font-medium text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 w-20">
                    Actions
                </th>
            </tr>
        </thead>
        <tbody id="<c> STR(page_container); </c>">
            <c> #include "./md_child_add_row.h" </c>
            <c> if (rows->items[ri].children[ti].count == 0) { </c>
                <tr><td colspan="<c> INT(config->children[ti].column_count + 1); </c>"
                        class="px-3 py-3 text-sm text-gray-400 text-center">No records</td></tr>
            <c> } else { </c>
                <c> for (size_t ci = cw_lo; ci < cw_hi; ++ci) { </c>
                    <c> #include "./md_child_rows.h" </c>
                <c> } </c>
            <c> } </c>
        </tbody>
    </table>

    <c> #include "./pagination.h" </c>

    <form id="mdf-a-<c> STR(config->children[ti].table); </c>-<c> STR(rows->items[ri].id); </c>"
          method="POST"
          action="<c> STR(config->children[ti].crud_path); </c>/create?<c> STR(config->children[ti].fk_column); </c>=<c> STR(rows->items[ri].id); </c>&redirect=<c> STR(md_path); </c>"
          data-md-kind="child"
          data-md-scope="<c> STR(config->children[ti].table); </c>"
          data-md-op="create"
          data-md-master="<c> STR(rows->items[ri].id); </c>"
          class="hidden">
    </form>

    <c> if (page_info.total > 0) { </c>
        <div class="m-1 text-sm text-amber-200">
            <c> INT(page_info.total); </c> record(s)
        </div>
    <c> } </c>

    <c> if (fragment) { </c>
        <table data-pg-rows="<c> STR(page_container); </c>" data-pg-unit="3">
            <tbody>
                <c> for (size_t ci = 0; ci < rows->items[ri].children[ti].count; ++ci) { </c>
                    <c> #include "./md_child_rows.h" </c>
                <c> } </c>
            </tbody>
        </table>
    <c> #include "./pager_templates.h" </c>
    <c> } </c>
</div>
