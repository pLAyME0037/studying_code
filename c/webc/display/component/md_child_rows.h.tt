<tr class="md-row hover:bg-gray-50 dark:hover:bg-gray-700/50"
    data-row-id="<c> STR(rows->items[ri].children[ti].items[ci].values[0]); </c>">
    <c>
    for (size_t cci = 0; cci < config->children[ti].column_count; ++cci) {
    </c>
        <td class="pl-3 text-sm text-gray-700 dark:text-gray-200">
            <c> ESCAPED(rows->items[ri].children[ti].items[ci].disp[cci + 1]); </c>
        </td>
    <c> } </c>
    <td class="p-1 whitespace-nowrap">
        <div class="flex gap-1 items-center">
            <button type="button"
                    class="child-edit-btn p-1 rounded text-amber-600 hover:bg-amber-100 dark:hover:bg-amber-900/40"
                    title="Edit"
                    aria-label="Edit">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            </button>
            <form method="POST"
                  action="<c> STR(config->children[ti].crud_path); </c>/<c> STR(rows->items[ri].children[ti].items[ci].values[0]); </c>/delete?redirect=<c> STR(md_path); </c>"
                  data-md-kind="child"
                  data-md-scope="<c> STR(config->children[ti].table); </c>"
                  data-md-op="delete"
                  data-md-master="<c> STR(rows->items[ri].id); </c>"
                  data-md-target="<c> STR(rows->items[ri].children[ti].items[ci].values[0]); </c>"
                  class="inline">
                <button type="submit"
                        title="Delete"
                        aria-label="Delete"
                        class="p-1 rounded text-red-600 hover:bg-red-100 dark:hover:bg-red-900/40">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
            </form>
        </div>
    </td>
</tr>
<tr class="md-edit-row hidden">
    <c> for (size_t cci = 0; cci < config->children[ti].column_count; ++cci) { </c>
        <td class="p-1">
        <c> if (config->children[ti].columns[cci].type == COL_TYPE_FK_SELECT) { </c>
            <select form="mdf-e-<c> STR(config->children[ti].table); </c>-<c> STR(rows->items[ri].children[ti].items[ci].values[0]); </c>"
                    name="<c> STR(config->children[ti].columns[cci].name); </c>"
                    class="w-full px-0.5 py-1.5 text-sm border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                <c> for (size_t o = 0; o < config->children[ti].columns[cci].opt_count; ++o) { </c>
                    <option value="<c> STR(config->children[ti].columns[cci].opt[o].id); </c>"
                        <c> if (strcmp(rows->items[ri].children[ti].items[ci].values[cci + 1], config->children[ti].columns[cci].opt[o].id) == 0) { </c>selected<c> } </c>>
                        <c> ESCAPED(config->children[ti].columns[cci].opt[o].label); </c>
                    </option>
                <c> } </c>
            </select>
        <c> } else { </c>
            <input form="mdf-e-<c> STR(config->children[ti].table); </c>-<c> STR(rows->items[ri].children[ti].items[ci].values[0]); </c>"
                   name="<c> STR(config->children[ti].columns[cci].name); </c>"
                   type="<c> if (config->children[ti].columns[cci].type == COL_TYPE_DATE) { </c>date<c> } else if (config->children[ti].columns[cci].type == COL_TYPE_NUM) { </c>number<c> } else { </c>text<c> } </c>"
                   <c> if (config->children[ti].columns[cci].type == COL_TYPE_NUM) { </c>step="any" <c> } </c>
                   value="<c> ESCAPED(rows->items[ri].children[ti].items[ci].values[cci + 1]); </c>"
                   class="w-full px-0.5 py-1.5 text-sm border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
        <c> } </c>
        </td>
    <c> } </c>
    <td class="p-1">
        <div class="flex flex-col gap-1 items-start">
            <button type="submit"
                    form="mdf-e-<c> STR(config->children[ti].table); </c>-<c> STR(rows->items[ri].children[ti].items[ci].values[0]); </c>"
                    title="Confirm"
                    aria-label="Confirm"
                    class="p-1 rounded text-green-600 hover:bg-green-100 dark:hover:bg-green-900/40">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </button>
            <button type="button"
                    class="md-discard p-1 rounded text-gray-500 hover:bg-gray-200 dark:hover:bg-gray-700"
                    title="Discard"
                    aria-label="Discard">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
    </td>
</tr>
<form id="mdf-e-<c> STR(config->children[ti].table); </c>-<c> STR(rows->items[ri].children[ti].items[ci].values[0]); </c>"
      method="POST"
      action="<c> STR(config->children[ti].crud_path); </c>/<c> STR(rows->items[ri].children[ti].items[ci].values[0]); </c>/update?<c> STR(config->children[ti].fk_column); </c>=<c> STR(rows->items[ri].id); </c>&redirect=<c> STR(md_path); </c>"
      data-md-kind="child"
      data-md-scope="<c> STR(config->children[ti].table); </c>"
      data-md-op="update"
      data-md-master="<c> STR(rows->items[ri].id); </c>"
      data-md-target="<c> STR(rows->items[ri].children[ti].items[ci].values[0]); </c>"
      class="hidden">
</form>
