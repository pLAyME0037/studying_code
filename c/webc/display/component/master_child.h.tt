<c> if (!fragment) { </c>
<div id="mc-root" class="max-w-full mx-auto">
    <form method="POST"
          action="<c> STR(config->crud_path); </c>/create?redirect=<c> STR(md_path); </c>"
          data-md-kind="master"
          data-md-scope="<c> STR(config->table); </c>"
          data-md-op="create"
          class="mb-3 p-2 bg-white dark:bg-gray-800 border border-gray-500 dark:border-gray-700">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">
            Add <c> ESCAPED(config->title); </c>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <c> for (size_t fi = 0; fi < form_cols.count; ++fi) { </c>
                <div class="mb-3">
                    <label class="block text-sm text-gray-600 dark:text-gray-300 mb-1">
                        <c> ESCAPED(form_cols.items[fi].col->label); </c>
                    </label>
                    <c> if (form_cols.items[fi].col->type == COL_TYPE_FK_SELECT) { </c>
                        <select name="<c> ESCAPED(form_cols.items[fi].col->name); </c>" required
                                class="w-full px-0.5 py-1.5 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                            <option value="">None</option>
                            <c> for (size_t o = 0; o < form_cols.items[fi].count; ++o) { </c>
                                <option value="<c> STR(form_cols.items[fi].items[o].id); </c>">
                                    <c> ESCAPED(form_cols.items[fi].items[o].label); </c>
                                </option>
                            <c> } </c>
                        </select>
                    <c> } else if (form_cols.items[fi].col->type == COL_TYPE_TEXTAREA) { </c>
                        <textarea name="<c> ESCAPED(form_cols.items[fi].col->name); </c>"
                                  rows="1"
                                  class="w-full px-0.5 py-1.5 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white"></textarea>
                    <c> } else { </c>
                        <input name="<c> ESCAPED(form_cols.items[fi].col->name); </c>"
                               type="<c> if (form_cols.items[fi].col->type == COL_TYPE_DATE) { </c>date<c> } else if (form_cols.items[fi].col->type == COL_TYPE_NUM) { </c>number<c> } else { </c>text<c> } </c>"
                               <c> if (form_cols.items[fi].col->type == COL_TYPE_NUM) { </c>step="any" <c> } </c>
                               class="w-full px-0.5 py-1.5 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-white">
                    <c> } </c>
                </div>
            <c> } </c>
        </div>
        <button type="submit"
            class="bg-gray-200 dark:bg-gray-700 text-sky-900 dark:text-sky-200 border-b-3 border-b-sky-200 hover:border-b-blue-700 p-1.5 font-medium">
            Confirm
        </button>
        <button type="reset"
            class="bg-gray-200 dark:bg-gray-700 text-orange-900 dark:text-orange-200 border-b-3 border-b-orange-200 hover:border-b-red-700 ml-2 p-1.5">
            Discard
        </button>
    </form>
<c> } </c>

<c> if (fragment) { </c>
