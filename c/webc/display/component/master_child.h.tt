<c> } else { </c>
    <div class="bg-white dark:bg-gray-800 border-gray-200 dark:border-gray-700 overflow-scroll border">
        <table class="w-full text-left border-collapse master-table">
            <thead class="bg-slate-100 dark:bg-slate-900 dark:text-white text-slate-800">
