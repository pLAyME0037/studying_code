<div>
    <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">
        ({ STR(mod->title); })
    </h2>

    <form method="POST" action="({ STR(mod->path); })/create"
          class="mb-6 p-5 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">Add ({ STR(mod->title); })</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            ({ #include "./crud_fields.h" })
        </div>
        <button type="submit"
                class="mt-3 px-4 py-2 rounded bg-indigo-600 hover:bg-indigo-700 text-white font-medium">Add</button>
    </form>

    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-indigo-600 text-white">
                <tr>
                    <th class="px-4 py-3 font-semibold">#</th>
                    ({ for (size_t i = 0; i < mod->column_count; ++i) { })
                    <th class="px-4 py-3 font-semibold">({ STR(mod->columns[i].label); })</th>
                    ({ } })
                    <th class="px-4 py-3 font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                ({ if (rows->count == 0) { })
                    <tr>
                        <td colspan="({ INT(mod->column_count + 2); })"
                            class="px-4 py-4 text-sm text-gray-500 dark:text-gray-400">
                            No records yet.
                        </td>
                    </tr>
                ({ } else for (size_t r = 0; r < rows->count; ++r) { })
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                        <td class="px-4 py-2 text-gray-500 dark:text-gray-400">
                            ({ LLINT(rows->items[r].id); })
                        </td>
                        ({ for (size_t i = 0; i < mod->column_count; ++i) { })
                        <td class="px-4 py-2 text-gray-700 dark:text-gray-200">
                            ({ ESCAPED(rows->items[r].labels[i]); })
                        </td>
                        ({ } })
                        <td class="px-4 py-2 whitespace-nowrap">
                            <a href="({ STR(mod->path); })/({ LLINT(rows->items[r].id); })/edit"
                               class="mr-2 px-2 py-1 rounded text-xs bg-amber-500 hover:bg-amber-600 text-white">
                               Edit
                            </a>
                            <form method="POST" 
                                  action="({ STR(mod->path); })/({ LLINT(rows->items[r].id); })/delete" 
                                  class="inline">
                                <button type="submit"
                                        class="px-2 py-1 rounded text-xs bg-red-500 hover:bg-red-600 text-white">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                ({ } })
            </tbody>
        </table>
    </div>
</div>
